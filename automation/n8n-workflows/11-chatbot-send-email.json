{
  "name": "11 - Chatbot Send Email (Internal Team) - Open Mind",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            { "name": "name" },
            { "name": "email" },
            { "name": "contactNumber" },
            { "name": "organization" },
            { "name": "designation" },
            { "name": "requirement" },
            { "name": "subject" },
            { "name": "teamName" }
          ]
        }
      },
      "id": "execute-workflow-trigger",
      "name": "When Called By The Agent",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [-1000, 300]
    },
    {
      "parameters": {
        "jsCode": "// Real team contact sheet. Fill in / correct addresses here — this is the\n// single place the agent's \"Send Email\" tool looks up who to notify.\nconst TEAM_CONTACTS = {\n  Sales: 'naveen@openmind.in',\n  'IT/Support': 'ajay@openmind.in',\n  Admin: 'ajay@openmind.in',\n  HR: 'hr@openmind.in',\n};\n\nconst input = $input.first().json;\nconst toEmail = TEAM_CONTACTS[input.teamName] || TEAM_CONTACTS.Sales;\n\nconst missing = ['name', 'email', 'contactNumber', 'requirement', 'subject', 'teamName']\n  .filter((f) => !input[f] || !String(input[f]).trim());\n\nreturn [{ json: { ...input, toEmail, missing, isComplete: missing.length === 0 } }];"
      },
      "id": "map-team-and-validate",
      "name": "Map Team & Validate Required Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-800, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            { "leftValue": "={{ $json.isComplete }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "is-complete",
      "name": "All Required Fields Present?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-580, 300]
    },
    {
      "parameters": {
        "fromEmail": "noreply@openmind.in",
        "toEmail": "={{ $json.toEmail }}",
        "subject": "={{ $json.subject }}",
        "text": "=New inquiry via Suhani (website chatbot)\n\nName: {{ $json.name }}\nEmail: {{ $json.email }}\nContact: {{ $json.contactNumber }}\nOrganization: {{ $json.organization }}\nDesignation: {{ $json.designation }}\n\nRequirement / Agenda:\n{{ $json.requirement }}",
        "options": {}
      },
      "id": "send-email",
      "name": "TODO: send email (configure SMTP/Gmail credential)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [-360, 220]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { result: `Sent to the ${$json.teamName} team.` } }];"
      },
      "id": "confirm-sent",
      "name": "Confirm Sent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-140, 220]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { result: `Missing info before I can send this: ${$json.missing.join(', ')}. Please ask the visitor for these.` } }];"
      },
      "id": "ask-for-missing",
      "name": "Ask For Missing Info",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-360, 400]
    }
  ],
  "connections": {
    "When Called By The Agent": { "main": [[{ "node": "Map Team & Validate Required Fields", "type": "main", "index": 0 }]] },
    "Map Team & Validate Required Fields": { "main": [[{ "node": "All Required Fields Present?", "type": "main", "index": 0 }]] },
    "All Required Fields Present?": {
      "main": [
        [{ "node": "TODO: send email (configure SMTP/Gmail credential)", "type": "main", "index": 0 }],
        [{ "node": "Ask For Missing Info", "type": "main", "index": 0 }]
      ]
    },
    "TODO: send email (configure SMTP/Gmail credential)": { "main": [[{ "node": "Confirm Sent", "type": "main", "index": 0 }]] }
  },
  "pinData": {},
  "meta": { "instanceId": "openmind-chatbot-send-email-v1" }
}
