    "Merge Results": { "main": [[{ "node": "Filter & Summarize (OpenAI)", "type": "main", "index": 0 }]] },
    "Filter & Summarize (OpenAI)": { "main": [[{ "node": "TODO: connect your output (Email / Slack / Sheet)", "type": "main", "index": 0 }]] }
