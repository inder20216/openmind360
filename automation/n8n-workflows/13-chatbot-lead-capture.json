{
  "name": "13 - Chatbot Pre-Chat Lead Capture - Open Mind",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "openmind-chatbot-lead-capture",
        "responseMode": "responseNode",
        "options": { "allowedOrigins": "*" }
      },
      "id": "webhook-trigger",
      "name": "Webhook — POST /openmind-chatbot-lead-capture",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-900, 300],
      "webhookId": "openmind-chatbot-lead-capture"
    },
    {
      "parameters": {
        "jsCode": "// Fires the moment a visitor submits the pre-chat step (phone, email, and\n// what they're looking for), before the conversation even starts.\n// Independent of whatever the chat itself does afterward — this is what\n// actually captures the lead.\nconst body = $input.first().json.body || {};\n\nconst countryCode = String(body.countryCode || '').trim();\nconst phone = String(body.phone || '').trim();\nconst email = String(body.email || '').trim();\nconst requirement = String(body.requirement || '').trim();\n\nconst validPhone = phone.length >= 6;\nconst validEmail = /\\S+@\\S+\\.\\S+/.test(email);\nconst validRequirement = requirement.length > 0;\nconst isValid = validPhone && validEmail && validRequirement;\n\nreturn [{\n  json: {\n    isValid,\n    countryCode,\n    phone,\n    email,\n    requirement,\n    capturedAt: new Date().toISOString(),\n    toEmail: 'sales@openmind.in',\n  },\n}];"
      },
      "id": "validate-shape",
      "name": "Validate Submission",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-680, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            { "leftValue": "={{ $json.isValid }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "is-valid",
      "name": "Looks Real?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-460, 300]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "value": "TODO_LEAD_SHEET_ID", "mode": "id" },
        "sheetName": { "__rl": true, "value": "TODO_SHEET_TAB_NAME", "mode": "list", "cachedResultName": "Sheet1" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Timestamp": "={{ $json.capturedAt }}",
            "Phone": "={{ $json.countryCode }} {{ $json.phone }}",
            "Email": "={{ $json.email }}",
            "Requirement": "={{ $json.requirement }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "append-sheet",
      "name": "TODO: append to Leads Sheet (set Sheet ID + Google Sheets credential)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [-240, 140],
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "TODO_GOOGLE_SHEETS_CREDENTIAL", "name": "Google Sheets account" }
      }
    },
    {
      "parameters": {
        "sendTo": "={{ $json.toEmail }}",
        "subject": "=New chat visitor on openmind.in — {{ $json.countryCode }} {{ $json.phone }}",
        "emailType": "text",
        "message": "=A visitor opened the website chatbot and shared their contact details before the conversation started.\n\nPhone: {{ $json.countryCode }} {{ $json.phone }}\nEmail: {{ $json.email }}\nLooking for: {{ $json.requirement }}\nCaptured at: {{ $json.capturedAt }}\n\nThis is a separate signal from anything Suhani discusses with them in the chat itself — treat it as a lead worth following up even if the conversation doesn't go anywhere. Already logged in the leads sheet.",
        "options": {}
      },
      "id": "send-email",
      "name": "TODO: notify Sales (configure Gmail credential)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [-20, 140],
      "credentials": {
        "gmailOAuth2": { "id": "TODO_GMAIL_OAUTH2_CREDENTIAL", "name": "Gmail account" }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: true } }}",
        "options": {
          "responseCode": 200,
          "responseHeaders": { "entries": [{ "name": "Access-Control-Allow-Origin", "value": "*" }] }
        }
      },
      "id": "respond-success",
      "name": "Respond: Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [200, 140]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: true } }}",
        "options": {
          "responseCode": 200,
          "responseHeaders": { "entries": [{ "name": "Access-Control-Allow-Origin", "value": "*" }] }
        }
      },
      "id": "respond-invalid",
      "name": "Respond: Fake Success (don't tip off bad data)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-240, 400]
    }
  ],
  "connections": {
